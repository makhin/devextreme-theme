{
  "name": "@smbc/devextreme-theme",
  "version": "0.2.0",
  "description": "SMBC DevExtreme theme adapter",
  "private": false,
  "type": "module",
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "restricted"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./styles.css": "./dist/styles.css",
    "./devextreme.css": "./dist/dx.smbc.css",
    "./overrides.css": "./dist/overrides.css",
    "./viz": {
      "types": "./dist/viz.d.ts",
      "import": "./dist/viz.js"
    }
  },
  "scripts": {
    "theme:build": "node scripts/build-theme.mjs",
    "build": "npm run theme:build && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "pack:check": "npm run build && node scripts/pack-check.mjs",
    "prepublishOnly": "node scripts/check-publish.mjs",
    "test:package": "npm run build && node scripts/test-theme-package.mjs",
    "test": "npm run check",
    "test:tokens": "node --test scripts/theme-metadata.test.mjs",
    "check": "npm run test:tokens && npm run build && node scripts/pack-check.mjs && node scripts/test-theme-package.mjs"
  },
  "peerDependencies": {
    "@smbc/theme": "0.1.0",
    "devextreme": "~26.1.4"
  },
  "devDependencies": {
    "@smbc/theme": "file:../smbc-theme/smbc-theme-0.1.0.tgz",
    "devextreme": "26.1.4",
    "devextreme-themebuilder": "26.1.4",
    "typescript": "6.0.2",
    "vite": "8.2.2"
  },
  "imports": {
    "#palette": {
      "types": "devextreme/viz/palette",
      "browser": "devextreme/viz/palette",
      "default": "devextreme/cjs/viz/palette.js"
    }
  }
}
